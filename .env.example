# ═══════════════════════════════════════════════════════
# BaskLab Clone — Firebase Configuration
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your NEW Firebase
# project credentials. Then update firebase-config.js
# with the same values.
#
# Find these in: Firebase Console → Project Settings
#                → General → Your apps → SDK snippet
#
# ⚠️  NEVER use the original project credentials here.
# ⚠️  NEVER commit .env or firebase-config.js with real values.
# ═══════════════════════════════════════════════════════

FIREBASE_API_KEY=your_new_api_key_here
FIREBASE_AUTH_DOMAIN=your-new-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-new-project-id
FIREBASE_STORAGE_BUCKET=your-new-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_new_sender_id
FIREBASE_APP_ID=your_new_app_id

# The original project ID (for reference only — DO NOT USE)
# ORIGINAL_PROJECT_ID=hoops-coach-a28a0
